# Copy to .env and fill in. Never commit .env.
FIRA_ENV=development
LOG_LEVEL=INFO

# --- databases (docker-compose) ---
POSTGRES_USER=fira
POSTGRES_PASSWORD=change-me-postgres
NEO4J_PASSWORD=change-me-neo4j

# --- security ---
# >= 32 random characters, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
JWT_SECRET=
JWT_TTL_MINUTES=60
# Initial users are created on first start only if these are set (min 10 chars; FIRA_ENV=production requires 12+).
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ANALYST_PASSWORD=
RATE_LIMIT_PER_MINUTE=120
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
PII_MASKING=true
# MCP: comma-separated key:role pairs; the MCP server process uses FIRA_MCP_API_KEY
MCP_API_KEYS=
FIRA_MCP_API_KEY=

# Optional hardening (defaults shown)
# MAX_BODY_BYTES=5000000          # larger request bodies get 413
# LOGIN_MAX_FAILURES=5            # failed logins per username within the window before lockout (429)
# LOGIN_WINDOW_MINUTES=15
# DB_CONNECT_TIMEOUT_S=5          # an unreachable database fails start-up in seconds
# ENABLE_API_DOCS=                # unset: docs on outside production, off in production
# METRICS_TOKEN=                  # lets a scraper read /metrics via the X-Metrics-Token header (otherwise admin JWT)

# --- data ---
SEED_CUSTOMERS=10000
TRAIN_ML_ON_START=false

# --- LLM (optional; FIRA works without one) ---
# LLM_PROVIDER: none | anthropic | openai | ollama
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_COST_INPUT_PER_MTOK=0
LLM_COST_OUTPUT_PER_MTOK=0
# Example: LLM_PROVIDER=anthropic LLM_MODEL=claude-sonnet-5-5

# --- embeddings: lsa (local, default) | openai ---
EMBEDDING_PROVIDER=lsa
EMBEDDING_MODEL=
# DOCUMENT_PARSER=docling   # requires the WITH_DOCLING=true image build arg

# --- backups (infrastructure/scripts/pg_backup.py) ---
# Passphrase for encrypted backups (>= 12 characters). Store it somewhere other than the backups themselves.
# BACKUP_PASSPHRASE=

# --- monitoring and deployment (optional) ---
# Override the monitoring alert policy file (defaults to backend/app/monitoring/monitoring_config.yaml)
# MONITORING_CONFIG_PATH=
# Serve a built frontend from the API (single-service deployments such as the Render demo)
# FRONTEND_DIST_DIR=
# Managed PostgreSQL URLs (postgres:// or postgresql://) are accepted; the psycopg driver is added automatically
# DATABASE_URL=
# Smaller synthetic bank for small instances (default 10000)
# SEED_CUSTOMERS=2000
